<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups -->
    <record id="module_category_todo" model="ir.module.category">
        <field name="name">Todo App</field>
        <field name="description">Category for Todo App access rights.</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_todo_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_todo"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">User can manage their own tasks.</field>
    </record>

    <record id="group_todo_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_todo"/>
        <field name="implied_ids" eval="[(4, ref('group_todo_user'))]"/>
        <field name="comment">Manager can manage all tasks and configurations.</field>
    </record>

    <!-- Record Rules -->
    <record id="todo_task_user_rule" model="ir.rule">
        <field name="name">Todo Task: User can only see own tasks</field>
        <field name="model_id" ref="model_todo_task"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_todo_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="todo_task_manager_rule" model="ir.rule">
        <field name="name">Todo Task: Manager can see all tasks</field>
        <field name="model_id" ref="model_todo_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_todo_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Multi-company Rules -->
    <record id="todo_task_company_rule" model="ir.rule">
        <field name="name">Todo Task: Multi-company</field>
        <field name="model_id" ref="model_todo_task"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="todo_category_company_rule" model="ir.rule">
        <field name="name">Todo Category: Multi-company</field>
        <field name="model_id" ref="model_todo_category"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- Weekly Task Rules -->
    <record id="todo_weekly_task_user_rule" model="ir.rule">
        <field name="name">Weekly Task: User can only see own tasks</field>
        <field name="model_id" ref="model_todo_weekly_task"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_todo_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="todo_weekly_task_manager_rule" model="ir.rule">
        <field name="name">Weekly Task: Manager can see all tasks</field>
        <field name="model_id" ref="model_todo_weekly_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_todo_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="todo_weekly_task_company_rule" model="ir.rule">
        <field name="name">Weekly Task: Multi-company</field>
        <field name="model_id" ref="model_todo_weekly_task"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
