<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_todo_task_wizard_form" model="ir.ui.view">
        <field name="name">todo.task.wizard.form</field>
        <field name="model">todo.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Batch Operations">
                <group>
                    <field name="operation" widget="radio"/>
                    <field name="task_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <group>
                    <field name="new_state" invisible="operation != 'change_state'"/>
                    <field name="category_id" invisible="operation != 'change_category'"/>
                    <field name="user_id" invisible="operation != 'change_assignee'"/>
                    <field name="tag_ids" widget="many2many_tags" invisible="operation != 'add_tags'"/>
                </group>
                <footer>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
