<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Demo Tasks -->
        <record id="demo_task_1" model="todo.task">
            <field name="name">Complete project proposal</field>
            <field name="description">&lt;p&gt;Prepare and submit the project proposal for Q1.&lt;/p&gt;</field>
            <field name="category_id" ref="category_work"/>
            <field name="tag_ids" eval="[(6, 0, [ref('tag_important')])]"/>
            <field name="priority">2</field>
            <field name="state">in_progress</field>
            <field name="progress">50</field>
            <field name="deadline" eval="(DateTime.today() + relativedelta(days=3)).strftime('%Y-%m-%d')"/>
        </record>

        <record id="demo_task_2" model="todo.task">
            <field name="name">Buy groceries</field>
            <field name="description">&lt;p&gt;Weekly grocery shopping.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Milk&lt;/li&gt;&lt;li&gt;Bread&lt;/li&gt;&lt;li&gt;Eggs&lt;/li&gt;&lt;li&gt;Fruits&lt;/li&gt;&lt;/ul&gt;</field>
            <field name="category_id" ref="category_shopping"/>
            <field name="priority">1</field>
            <field name="state">draft</field>
            <field name="deadline" eval="(DateTime.today() + relativedelta(days=1)).strftime('%Y-%m-%d')"/>
        </record>

        <record id="demo_task_3" model="todo.task">
            <field name="name">Morning workout routine</field>
            <field name="description">&lt;p&gt;30 minutes cardio + strength training.&lt;/p&gt;</field>
            <field name="category_id" ref="category_health"/>
            <field name="tag_ids" eval="[(6, 0, [ref('tag_important')])]"/>
            <field name="priority">1</field>
            <field name="state">done</field>
            <field name="progress">100</field>
        </record>

        <record id="demo_task_4" model="todo.task">
            <field name="name">Review team reports</field>
            <field name="description">&lt;p&gt;Review and provide feedback on weekly team reports.&lt;/p&gt;</field>
            <field name="category_id" ref="category_work"/>
            <field name="tag_ids" eval="[(6, 0, [ref('tag_review'), ref('tag_urgent')])]"/>
            <field name="priority">3</field>
            <field name="state">draft</field>
            <field name="deadline" eval="(DateTime.today()).strftime('%Y-%m-%d')"/>
        </record>

        <record id="demo_task_5" model="todo.task">
            <field name="name">Call dentist for appointment</field>
            <field name="description">&lt;p&gt;Schedule annual dental checkup.&lt;/p&gt;</field>
            <field name="category_id" ref="category_personal"/>
            <field name="tag_ids" eval="[(6, 0, [ref('tag_followup')])]"/>
            <field name="priority">0</field>
            <field name="state">draft</field>
            <field name="deadline" eval="(DateTime.today() + relativedelta(days=7)).strftime('%Y-%m-%d')"/>
        </record>
    </data>
</odoo>
