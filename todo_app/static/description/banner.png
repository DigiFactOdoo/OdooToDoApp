<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 300">
  <defs>
    <linearGradient id="bannerGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="900" height="300" fill="url(#bannerGrad)"/>
  
  <!-- Decorative circles -->
  <circle cx="800" cy="50" r="100" fill="white" opacity="0.1"/>
  <circle cx="100" cy="250" r="80" fill="white" opacity="0.1"/>
  
  <!-- Icon -->
  <g transform="translate(80, 100)">
    <rect width="100" height="100" rx="20" ry="20" fill="white" opacity="0.2"/>
    <g fill="white">
      <rect x="20" y="25" width="20" height="20" rx="4" ry="4" fill="none" stroke="white" stroke-width="3"/>
      <polyline points="24,35 28,40 36,30" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      <rect x="48" y="30" width="32" height="4" rx="2" ry="2"/>
      <rect x="48" y="38" width="20" height="3" rx="1.5" ry="1.5" opacity="0.6"/>
      <rect x="20" y="55" width="20" height="20" rx="4" ry="4" fill="none" stroke="white" stroke-width="3"/>
      <rect x="48" y="60" width="32" height="4" rx="2" ry="2"/>
      <rect x="48" y="68" width="24" height="3" rx="1.5" ry="1.5" opacity="0.6"/>
    </g>
  </g>
  
  <!-- Text -->
  <text x="220" y="140" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="white">Todo App</text>
  <text x="220" y="180" font-family="Arial, sans-serif" font-size="20" fill="white" opacity="0.9">Task Management for Odoo</text>
  <text x="220" y="220" font-family="Arial, sans-serif" font-size="16" fill="white" opacity="0.7">Organize • Track • Complete</text>
  
  <!-- Version badge -->
  <rect x="750" y="240" width="120" height="30" rx="15" ry="15" fill="white" opacity="0.2"/>
  <text x="810" y="260" font-family="Arial, sans-serif" font-size="14" fill="white" text-anchor="middle">v17.0.1.0.0</text>
</svg>
