<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tag Tree View -->
    <record id="view_todo_tag_tree" model="ir.ui.view">
        <field name="name">todo.tag.tree</field>
        <field name="model">todo.tag</field>
        <field name="arch" type="xml">
            <tree string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Tag Form View -->
    <record id="view_todo_tag_form" model="ir.ui.view">
        <field name="name">todo.tag.form</field>
        <field name="model">todo.tag</field>
        <field name="arch" type="xml">
            <form string="Tag">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tag Search View -->
    <record id="view_todo_tag_search" model="ir.ui.view">
        <field name="name">todo.tag.search</field>
        <field name="model">todo.tag</field>
        <field name="arch" type="xml">
            <search string="Search Tags">
                <field name="name"/>
                <filter name="filter_archived" string="Archived" 
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Tag Action -->
    <record id="action_todo_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">todo.tag</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create task tags
            </p>
            <p>
                Use tags to label and filter your tasks.
            </p>
        </field>
    </record>
</odoo>
