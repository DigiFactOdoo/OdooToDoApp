<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Category Tree View -->
    <record id="view_todo_category_tree" model="ir.ui.view">
        <field name="name">todo.category.tree</field>
        <field name="model">todo.category</field>
        <field name="arch" type="xml">
            <tree string="Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="color" widget="color_picker"/>
                <field name="task_count"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Category Form View -->
    <record id="view_todo_category_form" model="ir.ui.view">
        <field name="name">todo.category.form</field>
        <field name="model">todo.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks" type="object" 
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Category description..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Category Kanban View -->
    <record id="view_todo_category_kanban" model="ir.ui.view">
        <field name="name">todo.category.kanban</field>
        <field name="model">todo.category</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click"
                             t-attf-style="border-left: 5px solid #{kanban_color(record.color.raw_value)};">
                            <div class="oe_kanban_content">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle text-muted">
                                    <span><field name="task_count"/> Tasks</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Category Search View -->
    <record id="view_todo_category_search" model="ir.ui.view">
        <field name="name">todo.category.search</field>
        <field name="model">todo.category</field>
        <field name="arch" type="xml">
            <search string="Search Categories">
                <field name="name"/>
                <filter name="filter_archived" string="Archived" 
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Category Action -->
    <record id="action_todo_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">todo.category</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create task categories
            </p>
            <p>
                Organize your tasks by categories.
            </p>
        </field>
    </record>
</odoo>
