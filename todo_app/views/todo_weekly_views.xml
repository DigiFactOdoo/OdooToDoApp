<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =====================================================
         WEEKLY TASK VIEWS
         ===================================================== -->

    <!-- Weekly Task Tree View -->
    <record id="view_todo_weekly_task_tree" model="ir.ui.view">
        <field name="name">todo.weekly.task.tree</field>
        <field name="model">todo.weekly.task</field>
        <field name="arch" type="xml">
            <tree string="Weekly Tasks" 
                  decoration-success="is_done"
                  decoration-danger="priority_level=='a_must' and not is_done"
                  decoration-warning="priority_level=='b_should' and not is_done"
                  editable="bottom"
                  multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="task_date"/>
                <field name="day_name" optional="show"/>
                <field name="priority_level" widget="badge"
                       decoration-danger="priority_level=='a_must'"
                       decoration-warning="priority_level=='b_should'"
                       decoration-info="priority_level=='c_could'"/>
                <field name="name"/>
                <field name="is_done" widget="boolean_toggle"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Weekly Task Form View -->
    <record id="view_todo_weekly_task_form" model="ir.ui.view">
        <field name="name">todo.weekly.task.form</field>
        <field name="model">todo.weekly.task</field>
        <field name="arch" type="xml">
            <form string="Weekly Task">
                <header>
                    <button name="action_mark_done" string="✓ Mark Done" type="object" 
                            class="btn-success" invisible="is_done"/>
                    <button name="action_mark_undone" string="↺ Mark Undone" type="object"
                            class="btn-secondary" invisible="not is_done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Completed" bg_color="text-bg-success"
                            invisible="not is_done"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Task title..." class="text-break"/>
                        </h1>
                    </div>
                    <group>
                        <group name="left">
                            <field name="task_date"/>
                            <field name="day_name" readonly="1"/>
                            <field name="priority_level" widget="radio"/>
                        </group>
                        <group name="right">
                            <field name="is_done" widget="boolean_toggle"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Week Info" name="week_info">
                        <group>
                            <field name="week_start" readonly="1"/>
                            <field name="week_end" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Weekly Task Kanban View - Grouped by Day -->
    <record id="view_todo_weekly_task_kanban" model="ir.ui.view">
        <field name="name">todo.weekly.task.kanban</field>
        <field name="model">todo.weekly.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="task_date" 
                    class="o_kanban_small_column"
                    quick_create="true"
                    records_draggable="true"
                    group_create="false">
                <field name="color"/>
                <field name="is_done"/>
                <field name="priority_level"/>
                <field name="task_date"/>
                <progressbar field="is_done" 
                             colors='{"False": "secondary", "True": "success"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click #{record.is_done.raw_value ? 'oe_kanban_card_done' : ''}"
                             t-attf-style="border-left: 4px solid; border-left-color: #{record.priority_level.raw_value == 'a_must' ? '#dc3545' : (record.priority_level.raw_value == 'b_should' ? '#ffc107' : '#0d6efd')};">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title" t-att-style="record.is_done.raw_value ? 'text-decoration: line-through; opacity: 0.6;' : ''">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <field name="is_done" widget="boolean_toggle"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <span class="badge rounded-pill"
                                          t-attf-class="#{record.priority_level.raw_value == 'a_must' ? 'text-bg-danger' : (record.priority_level.raw_value == 'b_should' ? 'text-bg-warning' : 'text-bg-info')}">
                                        <field name="priority_level"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Weekly Task Kanban View - Grouped by Priority -->
    <record id="view_todo_weekly_task_kanban_priority" model="ir.ui.view">
        <field name="name">todo.weekly.task.kanban.priority</field>
        <field name="model">todo.weekly.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="priority_level"
                    class="o_kanban_small_column"
                    quick_create="true"
                    records_draggable="true"
                    group_create="false">
                <field name="color"/>
                <field name="is_done"/>
                <field name="priority_level"/>
                <field name="task_date"/>
                <field name="day_name"/>
                <progressbar field="is_done" 
                             colors='{"False": "secondary", "True": "success"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click #{record.is_done.raw_value ? 'opacity-50' : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title" t-att-style="record.is_done.raw_value ? 'text-decoration: line-through;' : ''">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <field name="is_done" widget="boolean_toggle"/>
                                </div>
                                <div class="o_kanban_record_body mt-1">
                                    <span class="badge text-bg-secondary">
                                        <i class="fa fa-calendar-o"/> <field name="day_name"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Weekly Task Calendar View -->
    <record id="view_todo_weekly_task_calendar" model="ir.ui.view">
        <field name="name">todo.weekly.task.calendar</field>
        <field name="model">todo.weekly.task</field>
        <field name="arch" type="xml">
            <calendar string="Weekly Tasks" 
                      date_start="task_date" 
                      color="priority_level"
                      mode="week"
                      quick_create="true"
                      event_limit="10">
                <field name="name"/>
                <field name="priority_level"/>
                <field name="is_done"/>
            </calendar>
        </field>
    </record>

    <!-- Weekly Task Search View -->
    <record id="view_todo_weekly_task_search" model="ir.ui.view">
        <field name="name">todo.weekly.task.search</field>
        <field name="model">todo.weekly.task</field>
        <field name="arch" type="xml">
            <search string="Search Weekly Tasks">
                <field name="name"/>
                <field name="task_date"/>
                <field name="user_id"/>
                <separator/>
                <filter name="filter_my_tasks" string="My Tasks" 
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_this_week" string="This Week"
                        domain="[]" context="{'week_filter': 'this_week'}"/>
                <filter name="filter_next_week" string="Next Week"
                        domain="[]" context="{'week_filter': 'next_week'}"/>
                <filter name="filter_last_week" string="Last Week"
                        domain="[]" context="{'week_filter': 'last_week'}"/>
                <separator/>
                <filter name="filter_not_done" string="Not Done" 
                        domain="[('is_done', '=', False)]"/>
                <filter name="filter_done" string="Done" 
                        domain="[('is_done', '=', True)]"/>
                <separator/>
                <filter name="filter_a_must" string="A - Must Do" 
                        domain="[('priority_level', '=', 'a_must')]"/>
                <filter name="filter_b_should" string="B - Should Do" 
                        domain="[('priority_level', '=', 'b_should')]"/>
                <filter name="filter_c_could" string="C - Could Do" 
                        domain="[('priority_level', '=', 'c_could')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="groupby_date" string="Date" 
                            context="{'group_by': 'task_date'}"/>
                    <filter name="groupby_day" string="Day of Week" 
                            context="{'group_by': 'day_of_week'}"/>
                    <filter name="groupby_priority" string="Priority" 
                            context="{'group_by': 'priority_level'}"/>
                    <filter name="groupby_week" string="Week" 
                            context="{'group_by': 'week_start'}"/>
                    <filter name="groupby_user" string="User" 
                            context="{'group_by': 'user_id'}"/>
                    <filter name="groupby_done" string="Status" 
                            context="{'group_by': 'is_done'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Weekly Task Graph View -->
    <record id="view_todo_weekly_task_graph" model="ir.ui.view">
        <field name="name">todo.weekly.task.graph</field>
        <field name="model">todo.weekly.task</field>
        <field name="arch" type="xml">
            <graph string="Weekly Tasks Analysis" type="bar">
                <field name="day_name" type="row"/>
                <field name="priority_level" type="col"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Weekly Task Pivot View -->
    <record id="view_todo_weekly_task_pivot" model="ir.ui.view">
        <field name="name">todo.weekly.task.pivot</field>
        <field name="model">todo.weekly.task</field>
        <field name="arch" type="xml">
            <pivot string="Weekly Tasks Analysis">
                <field name="week_start" type="row"/>
                <field name="priority_level" type="col"/>
                <field name="is_done" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- =====================================================
         ACTIONS
         ===================================================== -->

    <!-- Main Weekly Planner Action - Kanban by Date -->
    <record id="action_todo_weekly_planner" model="ir.actions.act_window">
        <field name="name">Weekly Planner</field>
        <field name="res_model">todo.weekly.task</field>
        <field name="view_mode">kanban,tree,calendar,form,graph,pivot</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_todo_weekly_task_kanban')}),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_todo_weekly_task_tree')}),
            (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_todo_weekly_task_calendar')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_todo_weekly_task_form')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_todo_weekly_task_graph')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_todo_weekly_task_pivot')})]"/>
        <field name="search_view_id" ref="view_todo_weekly_task_search"/>
        <field name="context">{
            'search_default_filter_my_tasks': 1,
            'search_default_filter_this_week': 1,
            'search_default_groupby_date': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your weekly to-do list!
            </p>
            <p>
                Organize your week with priority levels: Must Do, Should Do, Could Do.
            </p>
        </field>
    </record>

    <!-- Weekly Planner by Priority Action -->
    <record id="action_todo_weekly_by_priority" model="ir.actions.act_window">
        <field name="name">By Priority</field>
        <field name="res_model">todo.weekly.task</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_todo_weekly_task_kanban_priority')}),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_todo_weekly_task_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_todo_weekly_task_form')})]"/>
        <field name="search_view_id" ref="view_todo_weekly_task_search"/>
        <field name="context">{
            'search_default_filter_my_tasks': 1,
            'search_default_filter_this_week': 1,
            'search_default_groupby_priority': 1,
        }</field>
    </record>

    <!-- All Weekly Tasks Action -->
    <record id="action_todo_weekly_all" model="ir.actions.act_window">
        <field name="name">All Weekly Tasks</field>
        <field name="res_model">todo.weekly.task</field>
        <field name="view_mode">tree,kanban,calendar,form,graph,pivot</field>
        <field name="search_view_id" ref="view_todo_weekly_task_search"/>
        <field name="context">{'search_default_filter_my_tasks': 1}</field>
    </record>

    <!-- =====================================================
         WIZARD VIEWS
         ===================================================== -->

    <record id="view_todo_weekly_wizard_form" model="ir.ui.view">
        <field name="name">todo.weekly.wizard.form</field>
        <field name="model">todo.weekly.wizard</field>
        <field name="arch" type="xml">
            <form string="Weekly Planner Operations">
                <group>
                    <group string="Operation">
                        <field name="wizard_type" widget="radio"/>
                    </group>
                    <group string="Target Week">
                        <div class="d-flex align-items-center">
                            <button name="action_prev_week" string="◀" type="object" 
                                    class="btn-secondary me-2" icon="fa-chevron-left"/>
                            <field name="target_date" class="flex-grow-1"/>
                            <button name="action_next_week" string="▶" type="object" 
                                    class="btn-secondary ms-2" icon="fa-chevron-right"/>
                        </div>
                        <field name="target_week_display" readonly="1" string="Week Range"/>
                        <field name="existing_task_count" readonly="1"/>
                    </group>
                </group>
                <group invisible="wizard_type != 'copy_week'" string="Source Week">
                    <field name="source_date"/>
                    <field name="source_week_display" readonly="1"/>
                    <field name="copy_completed_status"/>
                </group>
                <group string="Priority Levels to Include">
                    <field name="include_a_must"/>
                    <field name="include_b_should"/>
                    <field name="include_c_could"/>
                </group>
                <footer>
                    <button name="action_execute" string="Execute" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_todo_weekly_wizard" model="ir.actions.act_window">
        <field name="name">Week Operations</field>
        <field name="res_model">todo.weekly.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
