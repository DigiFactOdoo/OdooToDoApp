<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Task Tree View -->
    <record id="view_todo_task_tree" model="ir.ui.view">
        <field name="name">todo.task.tree</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <tree string="Tasks" decoration-danger="is_overdue" decoration-muted="state=='cancelled'" 
                  decoration-success="state=='done'" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="category_id"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="priority" widget="priority"/>
                <field name="deadline"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge" 
                       decoration-info="state=='draft'"
                       decoration-primary="state=='in_progress'"
                       decoration-success="state=='done'"
                       decoration-danger="state=='cancelled'"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Task Form View -->
    <record id="view_todo_task_form" model="ir.ui.view">
        <field name="name">todo.task.form</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <form string="Task">
                <header>
                    <button name="action_start" string="Start" type="object" 
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark Done" type="object" 
                            class="btn-success" invisible="state not in ['draft', 'in_progress']"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['done', 'cancelled']"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ['cancelled', 'done']"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_set_high_priority" type="object" 
                                class="oe_stat_button" icon="fa-star"
                                invisible="priority == '2' or priority == '3'">
                            <span>Set High Priority</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger"
                            invisible="not is_overdue"/>
                    <widget name="web_ribbon" title="Completed" bg_color="text-bg-success"
                            invisible="state != 'done'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Task Title..." class="text-break"/>
                        </h1>
                    </div>
                    <group>
                        <group name="left">
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="category_id"/>
                            <field name="tag_ids" widget="many2many_tags" 
                                   options="{'color_field': 'color', 'no_create_edit': True}"/>
                        </group>
                        <group name="right">
                            <field name="priority" widget="priority"/>
                            <field name="deadline"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe the task..."/>
                        </page>
                        <page string="Additional Info" name="info">
                            <group>
                                <group>
                                    <field name="create_date"/>
                                    <field name="completed_date"/>
                                </group>
                                <group>
                                    <field name="days_remaining"/>
                                    <field name="is_overdue"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Task Kanban View -->
    <record id="view_todo_task_kanban" model="ir.ui.view">
        <field name="name">todo.task.kanban</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" 
                    quick_create="true" records_draggable="true">
                <field name="color"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="is_overdue"/>
                <progressbar field="state" 
                             colors='{"draft": "secondary", "in_progress": "primary", "done": "success", "cancelled": "danger"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click #{record.is_overdue.raw_value ? 'border-danger' : ''}" 
                             style="border-left: 5px solid;"
                             t-attf-style="border-left-color: #{kanban_color(record.color.raw_value)};">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-0">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <field name="priority" widget="priority"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="tag_ids" widget="many2many_tags" 
                                           options="{'color_field': 'color'}"/>
                                    <div t-if="record.deadline.raw_value" class="mt-1">
                                        <span class="badge rounded-pill" 
                                              t-attf-class="#{record.is_overdue.raw_value ? 'text-bg-danger' : 'text-bg-secondary'}">
                                            <i class="fa fa-clock-o"/> <field name="deadline"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="progress" widget="progressbar" 
                                               options="{'max_value': 100}"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Task Calendar View -->
    <record id="view_todo_task_calendar" model="ir.ui.view">
        <field name="name">todo.task.calendar</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <calendar string="Tasks Calendar" date_start="deadline" color="user_id" 
                      mode="month" quick_create="false" event_limit="5">
                <field name="name"/>
                <field name="user_id" avatar_field="image_128"/>
                <field name="state"/>
                <field name="priority"/>
            </calendar>
        </field>
    </record>

    <!-- Task Search View -->
    <record id="view_todo_task_search" model="ir.ui.view">
        <field name="name">todo.task.search</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <search string="Search Tasks">
                <field name="name"/>
                <field name="user_id"/>
                <field name="category_id"/>
                <field name="tag_ids"/>
                <separator/>
                <filter name="filter_my_tasks" string="My Tasks" 
                        domain="[('user_id', '=', uid)]"/>
                <filter name="filter_unassigned" string="Unassigned" 
                        domain="[('user_id', '=', False)]"/>
                <separator/>
                <filter name="filter_draft" string="Draft" 
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_in_progress" string="In Progress" 
                        domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_done" string="Done" 
                        domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="filter_overdue" string="Overdue" 
                        domain="[('is_overdue', '=', True)]"/>
                <filter name="filter_today" string="Due Today" 
                        domain="[]" context="{'deadline_filter': 'today'}"/>
                <filter name="filter_this_week" string="Due This Week"
                        domain="[]" context="{'deadline_filter': 'this_week'}"/>
                <separator/>
                <filter name="filter_high_priority" string="High Priority" 
                        domain="[('priority', 'in', ['2', '3'])]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" 
                        domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="groupby_state" string="Status" 
                            context="{'group_by': 'state'}"/>
                    <filter name="groupby_user" string="Assigned To" 
                            context="{'group_by': 'user_id'}"/>
                    <filter name="groupby_category" string="Category" 
                            context="{'group_by': 'category_id'}"/>
                    <filter name="groupby_priority" string="Priority" 
                            context="{'group_by': 'priority'}"/>
                    <filter name="groupby_deadline" string="Deadline" 
                            context="{'group_by': 'deadline'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Task Graph View -->
    <record id="view_todo_task_graph" model="ir.ui.view">
        <field name="name">todo.task.graph</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <graph string="Tasks Analysis" type="bar">
                <field name="state" type="row"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Task Pivot View -->
    <record id="view_todo_task_pivot" model="ir.ui.view">
        <field name="name">todo.task.pivot</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <pivot string="Tasks Analysis">
                <field name="state" type="row"/>
                <field name="category_id" type="col"/>
                <field name="id" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Task Action -->
    <record id="action_todo_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">todo.task</field>
        <field name="view_mode">kanban,tree,form,calendar,graph,pivot</field>
        <field name="search_view_id" ref="view_todo_task_search"/>
        <field name="context">{'search_default_filter_my_tasks': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first task!
            </p>
            <p>
                Organize your work and never miss a deadline.
            </p>
        </field>
    </record>

    <!-- My Tasks Action -->
    <record id="action_todo_my_tasks" model="ir.actions.act_window">
        <field name="name">My Tasks</field>
        <field name="res_model">todo.task</field>
        <field name="view_mode">kanban,tree,form,calendar</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{}</field>
    </record>

    <!-- Wizard Action -->
    <record id="action_todo_task_wizard" model="ir.actions.act_window">
        <field name="name">Batch Operations</field>
        <field name="res_model">todo.task.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_todo_task"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
